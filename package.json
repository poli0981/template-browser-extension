{
  "name": "browser-extension-template",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade GitHub template for cross-browser MV3 extensions (Chrome/Edge/Brave) — TypeScript + Vite 8, Node 24 LTS. Ready for 2026.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "SkullMute",
    "url": "https://github.com/poli0981"
  },
  "homepage": "https://github.com/poli0981/template-browser-extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poli0981/template-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/poli0981/template-browser-extension/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "mv3",
    "typescript",
    "vite",
    "template"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.290",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vitest": "^2.1.8"
  }
}
