{
  "default": true,
  "MD013": false, // line-length — disabled (Prettier handles wrap)
  "MD024": { "siblings_only": true }, // duplicate headings OK in different sections
  "MD033": false, // inline HTML OK (badges, callouts)
  "MD041": false, // first line need not be H1 (some files lead with a quote)
  "MD045": false // no-alt-text — too noisy on TODO-image placeholders
}
